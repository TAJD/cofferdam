# Vendored TS corpus (dev-machine only; populated by scripts/fetch-corpus.sh)
/tests/corpus/
/tests/corpus-results/
# cd-9hp.9 cp4 — per-run graph-build regression numbers. The committed
# regression budget lives in docs/decisions/0001-canonical-graph-schema.md;
# runtime rows here are dev-machine snapshots.
/tests/graph-bench-results/
# cd-9hp.4 cp1 — per-run parse-cache speedup numbers. Same dev-machine
# snapshot pattern as graph-bench-results.
/tests/parse-cache-bench-results/
# cd-9hp.4 cp2 — per-run findings-cache speedup numbers.
/tests/findings-cache-bench-results/
# cd-9hp.4 cp3 — per-run full-run-cache speedup numbers.
/tests/run-cache-bench-results/
# cd-9hp.4 cp4 — disk-backed cache speedup numbers.
/tests/disk-cache-bench-results/
# cd-9hp.4 cp5 — VS Code smoke-test extension build artefacts.
/editors/vscode/node_modules/
/editors/vscode/out/
/editors/vscode/package-lock.json
# cd-9hp.4 cp4 — runtime cache (gitignored at the user's CWD; the
